generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  projects     Project[]
  rooms        Room[]
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  style     String?
  roomType  String?
  budget    Int?
  createdAt DateTime @default(now())
  rooms     Room[]
}

model Room {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  beforeImage     String
  afterImage      String?
  style           String
  itemsJson       String   @default("[]")
  listingCopyJson String?
  videoUrl        String?
  videoError      String?
  sourceUrl       String?
  videoLoading    Boolean  @default(false)
  budget          Int?
  totalCost       Int?
  createdAt       DateTime @default(now())
}
